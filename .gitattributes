# Auto-detect text files and normalize line endings
* text=auto

# Explicit text files
*.ts text
*.js text
*.json text
*.md text
*.yml text
*.yaml text
*.sql text

# Binary files
*.db binary
*.sqlite binary

# Generated — exclude from GitHub language stats
dist/** linguist-generated

# Digest-bound frozen checkpoint fixtures must checkout as LF on every OS.
# Windows CRLF conversion breaks digests.legacySnapshot / digests.narrative and
# makes doctor report snapshot=conflict, narrative=conflict (see CI Windows lock jobs).
# More specific than the global *.json/*.md text rules above (last match wins per attr).
fixtures/checkpoints/** text eol=lf
