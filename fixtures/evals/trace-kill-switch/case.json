{
  "evalCaseSchemaVersion": 1,
  "id": "trace-kill-switch",
  "title": "KYRO_TRACE=0 disables trace writes",
  "kind": "replay",
  "tags": ["trace"],
  "agents": ["any"],
  "scope": "demo",
  "steps": [
    {
      "run": ["close-sprint", "--kyro-scope", "demo", "--outcome", "shipped", "--yes"],
      "env": { "KYRO_TRACE": "0" },
      "expect": { "exitCode": 0, "stdoutIncludes": ["Sprint 1 closed"] }
    },
    {
      "run": ["trace", "--kyro-scope", "demo", "--json"],
      "expect": { "exitCode": 0, "stdoutExcludes": ["\"type\""] }
    }
  ],
  "expectFinalState": false
}
