{
  "evalCaseSchemaVersion": 1,
  "id": "close-sprint-corruption",
  "title": "Doctor catches missing verbatim active-sprint snapshot",
  "kind": "replay",
  "tags": [
    "guardrail",
    "close-sprint"
  ],
  "agents": [
    "any"
  ],
  "scope": "demo",
  "steps": [
    {
      "run": [
        "doctor",
        "--artifacts",
        "--kyro-scope",
        "demo"
      ],
      "expect": {
        "exitCode": 1,
        "stdoutIncludes": [
          "[FAIL]",
          "closed sprint(s) without a verbatim active-sprint snapshot"
        ]
      }
    }
  ],
  "expectFinalState": true
}
